{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: gcc-15 Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: gcc-15 build active file", // Debe coincidir con el label de tu tasks.json
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
